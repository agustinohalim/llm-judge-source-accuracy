    family-names: Halim
    affiliation: "Information Systems and Technology, Universitas OSO, Pontianak, Indonesia"
    orcid: "https://orcid.org/0009-0008-4388-1174"
keywords:
  - large language models
  - LLM-as-a-judge
  - clinical summarisation
  - prediction-powered inference
  - measurement error
repository-code: "https://github.com/agustinohalim/llm-judge-source-accuracy"
